# Copie para .env e ajuste se precisar. Todos os valores aqui são fictícios.
# O .env fica na raiz e é lido pelo Docker Compose, pelo backend e pelo web.

# Docker Compose: `docker compose up` sobe o modo de desenvolvimento (só o PostgreSQL).
# A pilha completa sobe com `docker compose --profile app up`, que substitui este padrão.
COMPOSE_PROFILES=dev
# Porta do web na pilha app (http://localhost:3000). Dentro dos containers, o
# docker-compose.yml monta o resto a partir deste arquivo: DATABASE_URL e API_PORT da API,
# PORT, ORIGIN e API_BASE_URL do web.
APP_WEB_PORT=3000
# Origem pública do web na pilha app (spec publicacao-tunel, ADR-08). Sem ela, vale
# http://localhost:<APP_WEB_PORT>. Com ela, os formulários só funcionam por esse endereço.
# APP_ORIGIN=https://rolobby.com.br
# Token do Cloudflare Tunnel, usado só com docker-compose.tunnel.yml. É segredo: nunca vai
# para o git.
# CLOUDFLARE_TUNNEL_TOKEN=troque-pelo-token-do-tunel

# PostgreSQL local (docker-compose.yml)
POSTGRES_USER=ro_lobby
POSTGRES_PASSWORD=ro_lobby_dev
POSTGRES_DB=ro_lobby
POSTGRES_PORT=5432

# Backend (backend/). A DATABASE_URL usa os mesmos valores do PostgreSQL acima.
DATABASE_URL=postgres://ro_lobby:ro_lobby_dev@localhost:5432/ro_lobby?sslmode=disable
API_PORT=8080
# Aplicativo do Discord para o login (crie em https://discord.com/developers/applications).
# Troque pelos valores do seu aplicativo no .env; o Client Secret nunca vai para o git.
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=troque-pelo-client-secret
DISCORD_API_BASE_URL=https://discord.com/api

# Web (web/)
WEB_PORT=5173
# URL da API que o servidor do web consulta.
API_BASE_URL=http://localhost:8080
# Login com Discord no web: usa o mesmo DISCORD_CLIENT_ID acima. O Client Secret não vai
# para o web (RN-03). A URL de autorização aponta para o Discord falso nos testes.
DISCORD_AUTHORIZE_URL=https://discord.com/oauth2/authorize
