{
	"name": "ro-lobby-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run",
		"generate": "openapi-typescript ../openapi.yaml -o src/lib/api/schema.gen.ts",
		"test:e2e": "playwright test",
		"test:coverage": "vitest --run --coverage"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/chakra-petch": "^5.3.0",
		"@fontsource/figtree": "^5.3.0",
		"@lucide/svelte": "^1.78.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26",
		"@vitest/coverage-v8": "^5.1.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "~7.0",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"engines": {
		"node": ">=24.14.0 <25"
	}
}
